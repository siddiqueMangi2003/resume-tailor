# Frontend: embedded into the static GitHub Pages build
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side scheduled job sync only. Never expose this key to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Backend
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ASPOSE_CLIENT_ID=
ASPOSE_CLIENT_SECRET=
FRONTEND_ORIGINS=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8000

# Limits and temporary result retention
MAX_UPLOAD_MB=5
MAX_JOB_DESCRIPTION_CHARS=15000
RESULT_TTL_SECONDS=600
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=900
GROQ_TIMEOUT_SECONDS=90
LATEX_TIMEOUT_SECONDS=45
