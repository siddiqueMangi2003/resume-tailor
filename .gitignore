# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.npm-cache/
/.ci-verify/
/.lock-refresh/

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backend runtime and local environments
backend/.venv/
backend/venv/
backend/runtime/
backend/results/
backend/uploads/
backend/__pycache__/
backend/requirments.txt
backend/requirements.txt

# private/local resume source files
backend/data/*.pdf
backend/data/*.doc
backend/data/*.docx
backend/data/private/

# Python caches and test output
**/__pycache__/
.pytest_cache/
.ruff_cache/
.coverage

# OS/editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# unused local generator placeholders
public/placeholder*
